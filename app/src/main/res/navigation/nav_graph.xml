<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.biblioteca.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_registro"
            app:destination="@id/registroFragment" />

        <action
            android:id="@+id/action_login_to_catalogo"
            app:destination="@id/catalogoFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="com.example.biblioteca.ui.registro.RegistroFragment"
        android:label="Registro"
        tools:layout="@layout/fragment_registro" />

    <fragment
        android:id="@+id/catalogoFragment"
        android:name="com.example.biblioteca.ui.catalogo.CatalogoFragment"
        android:label="Catálogo">
        <action
            android:id="@+id/action_catalogo_to_perfil"
            app:destination="@id/perfilFragment" />
        <action
            android:id="@+id/action_catalogo_to_detalle"
            app:destination="@id/detalleLibroFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleLibroFragment"
        android:name="com.example.biblioteca.ui.detalle.DetalleLibroFragment"
        android:label="Detalle del Libro"
        tools:layout="@layout/fragment_detalle_libro" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.biblioteca.ui.perfil.PerfilFragment"
        android:label="Perfil"
        tools:layout="@layout/fragment_perfil">
        <action
            android:id="@+id/action_perfil_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>